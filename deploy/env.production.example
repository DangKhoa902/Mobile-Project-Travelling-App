# Mẫu .env cho VPS với tên miền chantroixaxoi.xyz.
# Trên VPS: cp deploy/env.production.example .env  rồi điền các ô <...>. KHÔNG commit file .env.

# ---------- Bí mật: tạo chuỗi ngẫu nhiên, mỗi ô một chuỗi khác nhau ----------
# Tạo bằng: openssl rand -hex 32
DB_PASSWORD=<chuoi-ngau-nhien-1>
DB_ROOT_PASSWORD=<chuoi-ngau-nhien-2>
# Tạo bằng: openssl rand -hex 48
JWT_SECRET=<chuoi-ngau-nhien-dai>

# ---------- Tên miền ----------
CORS_ORIGINS=https://app.chantroixaxoi.xyz
APP_URL=https://app.chantroixaxoi.xyz
PUBLIC_BASE_URL=https://api.chantroixaxoi.xyz
# Email nhận thông báo chứng chỉ HTTPS từ Let's Encrypt.
ACME_EMAIL=<email-cua-ban>

# API chỉ mở cho Caddy trên cùng máy, không mở thẳng ra Internet.
API_PORT=127.0.0.1:3000
TRUST_PROXY=1

# ---------- Email thật (xác thực email, quên mật khẩu) ----------
# Gmail: bật xác minh 2 bước → tạo App Password tại myaccount.google.com/apppasswords
# Chưa có thì để EMAIL_TRANSPORT=console (link chỉ in ra log của API).
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<gmail-cua-ban>
SMTP_PASS=<app-password-16-ky-tu>
MAIL_FROM=Travelling App <gmail-cua-ban>

# ---------- Tùy chọn ----------
# Đăng nhập Google: client ID (web, Android), phân tách dấu phẩy. Xem docs/03-trien-khai/dang-nhap-google.md
GOOGLE_CLIENT_IDS=
# Push chỉ chạy khi đã build APK có Firebase (mục 6.5 trien-khai-production.md).
PUSH_ENABLED=false
# Thu lỗi bằng Sentry (để trống = tắt).
SENTRY_DSN=
SENTRY_RELEASE=v1.0.0
# Mật khẩu tài khoản demo nếu chạy seed (chỉ cho bản demo) – đổi khác Password123.
SEED_DEFAULT_PASSWORD=<mat-khau-demo>
