# Môi trường chạy: development | test | production
NODE_ENV=development

PORT=3000

# MariaDB connection string. URL-encode ký tự đặc biệt trong username/password.
DATABASE_URL="mysql://username:password@localhost:3306/travelling_app"
DATABASE_CONNECTION_LIMIT=5

# Bí mật ký JWT, tối thiểu 32 ký tự. Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Access token ngắn hạn; app làm mới bằng refresh token (POST /api/auth/refresh).
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# Origin được phép gọi API (web build). "*" chỉ dùng khi dev. Ví dụ: https://travelling-app.example.com
CORS_ORIGINS=*

# Thuế/phí áp lên booking (0.08 = 8%).
BOOKING_TAX_RATE=0.08

# Hạn thanh toán online (phút). Quá hạn booking tự hủy.
PAYMENT_TIMEOUT_MINUTES=15

# Số proxy đứng trước API (Nginx/Render/Railway = 1). 0 khi chạy trực tiếp.
TRUST_PROXY=0

# Địa chỉ giao diện web, dùng tạo link trong email xác thực / đặt lại mật khẩu.
APP_URL=http://localhost:8081

# Email: console = in ra log (dev, API trả kèm devToken); smtp = gửi thật.
EMAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Travelling App <no-reply@travelling.app>"

# Push notification qua Expo (cần mạng ra ngoài).
PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=

# Lưu ảnh: local = thư mục UPLOAD_DIR, phục vụ ở PUBLIC_BASE_URL/uploads; s3 = S3 / Cloudflare R2 / MinIO.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:3000
UPLOAD_MAX_MB=5
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Đăng nhập Google: client ID OAuth (Web, Android, iOS) từ Google Cloud Console, phân tách bằng dấu phẩy.
# Để trống = tắt đăng nhập Google. Hướng dẫn: docs/03-trien-khai/dang-nhap-google.md
GOOGLE_CLIENT_IDS=

# Log mỗi request một dòng JSON (route, status, ms). Request chậm hơn SLOW_REQUEST_MS ghi level "warn".
REQUEST_LOG=true
SLOW_REQUEST_MS=1000

# Sentry: để trống SENTRY_DSN thì không gửi lỗi ra ngoài.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# Mật khẩu cho tài khoản demo khi chạy npm run db:seed.
SEED_DEFAULT_PASSWORD=Password123
