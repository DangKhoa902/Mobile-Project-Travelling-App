# Môi trường chạy: development | test | production
NODE_ENV=development

PORT=3000

# MariaDB connection string. URL-encode ký tự đặc biệt trong username/password.
DATABASE_URL="mysql://username:password@localhost:3306/travelling_app"
DATABASE_CONNECTION_LIMIT=5

# Bí mật ký JWT, tối thiểu 32 ký tự. Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN=7d

# Origin được phép gọi API (web build). "*" chỉ dùng khi dev. Ví dụ: https://travelling-app.example.com
CORS_ORIGINS=*

# Thuế/phí áp lên booking (0.08 = 8%).
BOOKING_TAX_RATE=0.08

# Số proxy đứng trước API (Nginx/Render/Railway = 1). 0 khi chạy trực tiếp.
TRUST_PROXY=0

# Mật khẩu cho tài khoản demo khi chạy npm run db:seed.
SEED_DEFAULT_PASSWORD=Password123
