generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Số tiền lưu bằng Int theo đơn vị VNĐ (VNĐ không có phần lẻ).

enum Role {
  USER
  OWNER
  STAFF
  ADMIN
}

// Hồ sơ đối tác (chủ địa điểm) do admin duyệt.
enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

// Trạng thái kiểm duyệt tin đăng địa điểm.
enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum UserStatus {
  ACTIVE
  LOCKED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  ONLINE_MOCK
  PAY_AT_PROPERTY
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ServicePricingUnit {
  PER_BOOKING
  PER_GUEST
  PER_NIGHT
}

enum DiscountType {
  PERCENT
  FIXED
}

enum NotificationType {
  BOOKING
  PAYMENT
  SUPPORT
  REVIEW
  PARTNER
  SYSTEM
}

enum PayoutStatus {
  PENDING
  PAID
  CANCELLED
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum ConversationStatus {
  OPEN
  CLOSED
}

model User {
  id              Int        @id @default(autoincrement())
  name            String
  email           String     @unique
  password        String
  phone           String?    @db.VarChar(20)
  dateOfBirth     DateTime?  @db.Date
  avatarUrl       String?    @db.VarChar(500)
  // NULL = chưa xác thực email.
  emailVerifiedAt DateTime?
  role            Role       @default(USER)
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  bookings              Booking[]
  favorites             Favorite[]
  reviews               Review[]            @relation("ReviewAuthor")
  moderatedReviews      Review[]            @relation("ReviewModerator")
  notifications         Notification[]
  conversations         Conversation[]      @relation("ConversationCustomer")
  assignedConversations Conversation[]      @relation("ConversationStaff")
  messages              Message[]
  partnerProfile        PartnerProfile?     @relation("PartnerUser")
  reviewedPartners      PartnerProfile[]    @relation("PartnerReviewer")
  ownedDestinations     Destination[]       @relation("DestinationOwner")
  refreshTokens         RefreshToken[]
  verificationTokens    VerificationToken[]
  deviceTokens          DeviceToken[]
  auditLogs             AuditLog[]
  payouts               Payout[]            @relation("PayoutOwner")
  createdPayouts        Payout[]            @relation("PayoutCreator")
  uploads               Upload[]
}

// Refresh token xoay vòng: mỗi lần dùng sẽ bị thu hồi và thay bằng token mới.
model RefreshToken {
  id           Int       @id @default(autoincrement())
  userId       Int
  // Chỉ lưu SHA-256 của token, không lưu token gốc.
  tokenHash    String    @unique @db.Char(64)
  deviceName   String?   @db.VarChar(100)
  userAgent    String?   @db.VarChar(255)
  ip           String?   @db.VarChar(64)
  expiresAt    DateTime
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  replacedById Int?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

// Token một lần cho xác thực email và đặt lại mật khẩu.
model VerificationToken {
  id        Int                   @id @default(autoincrement())
  userId    Int
  type      VerificationTokenType
  tokenHash String                @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// Expo push token của từng thiết bị đã đăng nhập.
model DeviceToken {
  id         Int            @id @default(autoincrement())
  userId     Int
  token      String         @unique @db.VarChar(255)
  platform   DevicePlatform
  createdAt  DateTime       @default(now())
  lastSeenAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Nhật ký thao tác quản trị: ai làm gì, trên đối tượng nào, giá trị trước/sau.
model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  action    String   @db.VarChar(64)
  entity    String   @db.VarChar(64)
  entityId  String?  @db.VarChar(64)
  before    Json?
  after     Json?
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// Kỳ đối soát: gom doanh thu của chủ địa điểm từ các booking đã hoàn thành để chuyển khoản.
model Payout {
  id                Int          @id @default(autoincrement())
  ownerId           Int
  periodStart       DateTime     @db.Date
  periodEnd         DateTime     @db.Date
  bookingCount      Int
  grossAmount       Int
  commissionAmount  Int
  amount            Int
  status            PayoutStatus @default(PENDING)
  // Tài khoản nhận tiền chụp lại lúc lập kỳ.
  bankName          String?
  bankAccountNumber String?      @db.VarChar(30)
  bankAccountName   String?
  transferRef       String?      @db.VarChar(100)
  note              String?      @db.Text
  paidAt            DateTime?
  cancelledAt       DateTime?
  createdById       Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  owner     User      @relation("PayoutOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy User?     @relation("PayoutCreator", fields: [createdById], references: [id], onDelete: SetNull)
  bookings  Booking[]

  @@index([ownerId, status])
}

// File người dùng tải lên (ảnh đại diện, ảnh địa điểm, ảnh đánh giá).
model Upload {
  id        Int      @id @default(autoincrement())
  userId    Int
  key       String   @unique @db.VarChar(255)
  url       String   @db.VarChar(500)
  mimeType  String   @db.VarChar(50)
  size      Int
  purpose   String   @db.VarChar(20)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PartnerProfile {
  id                Int           @id @default(autoincrement())
  userId            Int           @unique
  businessName      String
  taxCode           String?       @db.VarChar(20)
  businessAddress   String        @db.VarChar(500)
  contactPhone      String        @db.VarChar(20)
  description       String?       @db.Text
  // Tài khoản nhận tiền đối soát.
  bankName          String?
  bankAccountNumber String?       @db.VarChar(30)
  bankAccountName   String?
  status            PartnerStatus @default(PENDING)
  // Tỷ lệ hoa hồng sàn thu trên (tạm tính - giảm giá). 0.15 = 15%.
  commissionRate    Float         @default(0.15)
  rejectReason      String?
  reviewedById      Int?
  reviewedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user       User  @relation("PartnerUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("PartnerReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  iconName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  destinations Destination[]
}

model Facility {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  iconName String?

  destinations Destination[]
}

model Destination {
  id                  Int           @id @default(autoincrement())
  name                String
  slug                String        @unique
  description         String?       @db.Text
  location            String
  address             String?       @db.VarChar(500)
  latitude            Float?
  longitude           Float?
  imageUrl            String?       @db.VarChar(500)
  contactPhone        String?       @db.VarChar(20)
  contactEmail        String?
  policy              String?       @db.Text
  isActive            Boolean       @default(true)
  isFeatured          Boolean       @default(false)
  // Giá "từ" thấp nhất, cập nhật khi gói thay đổi để lọc/sắp xếp nhanh.
  minPrice            Int           @default(0)
  averageRating       Float         @default(0)
  reviewCount         Int           @default(0)
  categoryId          Int?
  // NULL = địa điểm do sàn tự quản lý.
  ownerId             Int?
  listingStatus       ListingStatus @default(APPROVED)
  listingRejectReason String?
  submittedAt         DateTime?
  approvedAt          DateTime?
  // Tên + khu vực + địa chỉ + danh mục, viết thường, bỏ dấu: "da lat pine hill resort da lat ...".
  searchText          String        @default("") @db.VarChar(1000)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  owner User? @relation("DestinationOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  category   Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images     DestinationImage[]
  facilities Facility[]
  packages   Package[]
  roomTypes  RoomType[]
  services   AddonService[]
  bookings   Booking[]
  favorites  Favorite[]
  reviews    Review[]

  @@index([location])
  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([ownerId])
  @@index([listingStatus])
}

model DestinationImage {
  id            Int    @id @default(autoincrement())
  destinationId Int
  url           String @db.VarChar(500)
  sortOrder     Int    @default(0)

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
}

model Package {
  id                    Int      @id @default(autoincrement())
  destinationId         Int
  name                  String
  description           String?  @db.Text
  // Danh sách quyền lợi hiển thị, ví dụ ["Ăn sáng", "Đưa đón sân bay"].
  inclusions            Json?
  durationDays          Int
  durationNights        Int
  price                 Int
  // Số giờ trước giờ nhận phòng mà khách vẫn được hủy miễn phí (BR-07).
  freeCancellationHours Int      @default(48)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  bookings    Booking[]

  @@index([destinationId])
}

model RoomType {
  id            Int      @id @default(autoincrement())
  destinationId Int
  name          String
  description   String?  @db.Text
  capacity      Int
  pricePerNight Int
  // Tổng số phòng thuộc loại này; số phòng còn trống được tính từ các booking đang giữ chỗ.
  totalRooms    Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  bookings    Booking[]
  rates       RoomRate[]

  @@index([destinationId])
}

// Giá theo mùa / ngày lễ: ghi đè pricePerNight cho các đêm trong [startDate, endDate] (gồm cả hai ngày).
model RoomRate {
  id            Int      @id @default(autoincrement())
  roomTypeId    Int
  name          String   @db.VarChar(100)
  startDate     DateTime @db.Date
  endDate       DateTime @db.Date
  pricePerNight Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([roomTypeId, startDate, endDate])
}

model AddonService {
  id            Int                @id @default(autoincrement())
  destinationId Int
  name          String
  description   String?            @db.Text
  price         Int
  pricingUnit   ServicePricingUnit @default(PER_BOOKING)
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  destination     Destination      @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  bookingServices BookingService[]

  @@index([destinationId])
}

model Voucher {
  id            Int          @id @default(autoincrement())
  code          String       @unique
  description   String?
  discountType  DiscountType
  value         Int
  maxDiscount   Int?
  minOrderValue Int          @default(0)
  usageLimit    Int?
  usedCount     Int          @default(0)
  startsAt      DateTime
  endsAt        DateTime
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  bookings Booking[]
}

model Booking {
  id     Int           @id @default(autoincrement())
  code   String        @unique
  status BookingStatus @default(PENDING)

  userId        Int
  destinationId Int
  packageId     Int
  roomTypeId    Int
  voucherId     Int?

  checkInDate  DateTime @db.Date
  checkOutDate DateTime @db.Date
  nights       Int
  guests       Int
  roomsCount   Int

  contactName  String
  contactPhone String  @db.VarChar(20)
  contactEmail String
  note         String? @db.Text

  // Giá được chụp lại tại thời điểm đặt để không đổi khi admin sửa bảng giá.
  packagePrice   Int
  roomPrice      Int
  servicesPrice  Int
  subtotal       Int
  discountAmount Int @default(0)
  taxAmount      Int @default(0)
  totalAmount    Int

  // Hoa hồng môi giới chụp lại lúc đặt: commissionAmount + ownerRevenue = subtotal - discountAmount.
  commissionRate   Float @default(0)
  commissionAmount Int   @default(0)
  ownerRevenue     Int   @default(0)

  // Hạn thanh toán của booking thanh toán online; quá hạn sẽ tự hủy để trả phòng.
  paymentDueAt DateTime?

  // Kỳ đối soát đã gom booking này; NULL = chưa chuyển tiền cho chủ.
  payoutId Int?

  confirmedAt  DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id])
  destination Destination      @relation(fields: [destinationId], references: [id])
  package     Package          @relation(fields: [packageId], references: [id])
  roomType    RoomType         @relation(fields: [roomTypeId], references: [id])
  voucher     Voucher?         @relation(fields: [voucherId], references: [id])
  payout      Payout?          @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  services    BookingService[]
  payment     Payment?
  review      Review?

  @@index([userId, status])
  @@index([roomTypeId, checkInDate, checkOutDate])
  @@index([status])
  @@index([status, paymentDueAt])
  @@index([payoutId])
}

model BookingService {
  id             Int @id @default(autoincrement())
  bookingId      Int
  addonServiceId Int
  quantity       Int
  unitPrice      Int
  totalPrice     Int

  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addonService AddonService @relation(fields: [addonServiceId], references: [id])

  @@index([bookingId])
}

model Payment {
  id             Int           @id @default(autoincrement())
  bookingId      Int           @unique
  method         PaymentMethod
  status         PaymentStatus @default(UNPAID)
  // Kênh khách chọn trên cổng giả lập: CARD, EWALLET, BANK_TRANSFER.
  channel        String?       @db.VarChar(30)
  amount         Int
  transactionRef String?       @unique
  paidAt         DateTime?
  refundedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Favorite {
  userId        Int
  destinationId Int
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  // BR-03: mỗi user chỉ yêu thích một địa điểm một lần.
  @@id([userId, destinationId])
}

model Review {
  id            Int          @id @default(autoincrement())
  userId        Int
  destinationId Int
  // BR-02 + BR-08: review gắn với một booking đã hoàn thành, mỗi booking một review.
  bookingId     Int          @unique
  rating        Int
  comment       String?      @db.Text
  status        ReviewStatus @default(PENDING)
  moderatedById Int?
  moderatedAt   DateTime?
  rejectReason  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user        User          @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)
  destination Destination   @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  moderatedBy User?         @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  images      ReviewImage[]

  @@index([destinationId, status])
  @@index([status])
}

model ReviewImage {
  id        Int    @id @default(autoincrement())
  reviewId  Int
  url       String @db.VarChar(500)
  sortOrder Int    @default(0)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model Conversation {
  id            Int                @id @default(autoincrement())
  customerId    Int
  staffId       Int?
  bookingId     Int?
  subject       String
  status        ConversationStatus @default(OPEN)
  lastMessageAt DateTime           @default(now())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  customer User      @relation("ConversationCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  staff    User?     @relation("ConversationStaff", fields: [staffId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([customerId])
  @@index([status, lastMessageAt])
}

model Message {
  id             Int       @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String    @db.Text
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String
  body      String           @db.Text
  data      Json?
  isRead    Boolean          @default(false)
  // Đã xử lý gửi push (gửi xong hoặc người nhận không có thiết bị). NULL = đang chờ gửi.
  pushedAt  DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([pushedAt, createdAt])
}
