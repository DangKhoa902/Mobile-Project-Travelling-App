# Dùng khi build production (npx expo export / EAS build). Địa chỉ API được nhúng vào code lúc build.
EXPO_PUBLIC_API_URL=https://api.chantroixaxoi.xyz/api
# Client ID Google (để trống = ẩn nút Google). Xem docs/03-trien-khai/dang-nhap-google.md
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
