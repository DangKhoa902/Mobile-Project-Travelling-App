# Dùng cho docker-compose.yml. Copy thành .env và thay giá trị thật.
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Domain web build được phép gọi API, phân tách bằng dấu phẩy. Ví dụ: https://travelling-app.example.com
CORS_ORIGINS=*
API_PORT=3000
# 1 nếu đặt sau reverse proxy (Nginx, Caddy, Render...).
TRUST_PROXY=0
